{
  "name": "mesovortexwx",
  "version": "1.0.0",
  "private": true,
  "description": "MesoVortexWX weather radar desktop application",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "dist:windows": "next build && npm run prepare:desktop && electron-builder --win nsis --x64 --publish never",
    "test:capability": "node scripts/test-capability-matrix.mjs",
    "test:capability-consistency": "node scripts/test-capability-consistency.mjs",
    "test:fake-data": "node scripts/test-fake-data-guards.mjs",
    "test:archive": "node scripts/test-archive-integrity.mjs",
    "test:verify": "node scripts/test-capability-matrix.mjs && node scripts/test-satellite-capability-matrix.mjs && node scripts/test-observation-capabilities.mjs && node scripts/test-severe-capabilities.mjs && node scripts/test-aviation-marine-capabilities.mjs && node scripts/test-platform-capabilities.mjs && node scripts/test-sounding-capabilities.mjs && node scripts/test-radar-render-config.mjs && node scripts/test-fake-data-guards.mjs && node scripts/test-archive-integrity.mjs && node scripts/test-capability-consistency.mjs && node scripts/test-alert-integrity.mjs && node scripts/test-legend-integrity.mjs && node scripts/test-rotation-workflow.mjs && node scripts/test-tilt-workflow.mjs && node scripts/test-product-catalog.mjs && node scripts/test-mesoai-m1.mjs && node scripts/test-mesoai-engine.mjs && node scripts/test-phase4c-surface.mjs",
    "test:satellite-capability": "node scripts/test-satellite-capability-matrix.mjs",
    "test:observation-capabilities": "node scripts/test-observation-capabilities.mjs",
    "test:severe-capabilities": "node scripts/test-severe-capabilities.mjs",
    "test:aviation-marine-capabilities": "node scripts/test-aviation-marine-capabilities.mjs",
    "test:platform-capabilities": "node scripts/test-platform-capabilities.mjs",
    "test:sounding-capabilities": "node scripts/test-sounding-capabilities.mjs",
    "test:radar-render-config": "node scripts/test-radar-render-config.mjs",
    "test:alert-integrity": "node scripts/test-alert-integrity.mjs",
    "test:legend-integrity": "node scripts/test-legend-integrity.mjs",
    "test:mesoai-m1": "node scripts/test-mesoai-m1.mjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "chart.js": "^4.4.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.16.0",
    "nexrad-level-2-data": "^2.4.3",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.16.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  },
  "build": {
    "appId": "org.mesovortexwx.desktop",
    "productName": "MesoVortexWX",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      ".next/standalone/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "MesoVortexWX-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MesoVortexWX"
    }
  }
}
