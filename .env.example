# MesoVortexWX Environment Configuration
# Copy to .env.local for local development. Do NOT commit real secrets.

# Mapbox basemap token (public/client token; restrict by domain in Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=

# MapTiler fallback key
NEXT_PUBLIC_MAPTILER_KEY=

# NOAA/NWS contact header (required by api.weather.gov policy)
NWS_CONTACT_EMAIL=

# Google Gemini API key (AI features)
GEMINI_API_KEY=

# AgroMonitoring API key (agro weather features)
AGROMONITORING_API_KEY=

# WeatherPower API key (sounding endpoint)
WEATHERPOWER_API_KEY=

# MesoAI optional Qwen-compatible renderer.
# Disabled by default; the deterministic local renderer is always used unless
# MESOAI_ENABLED=1 and a valid OpenAI-compatible endpoint is configured.
# Never commit a real key here. Use .env.local, which is gitignored.
MESOAI_ENABLED=
MESOAI_BASE_URL=
MESOAI_MODEL=qwen2.5
MESOAI_API_KEY=
